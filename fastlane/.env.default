# Copy the variables you need into fastlane/.env (gitignored) and fill them in.
# Fastlane loads fastlane/.env automatically. In CI, set them as secrets instead.

# App Store Connect API key (Users and Access > Integrations > App Store Connect API)
# ASC_KEY_ID=ABC123DEFG
# ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Raw .p8 contents (quoted, multi-line) or base64:  base64 -i AuthKey_XXXX.p8 | pbcopy
# ASC_KEY_CONTENT=

# create_apps lane only (Apple ID login, not the API key)
# FASTLANE_APPLE_ID=
# FASTLANE_ITC_TEAM_ID=
# App Store names must be unique across Apple and avoid punctuation like ":"; override on a collision
# ASC_NAME_IOS=
# ASC_NAME_ADMIN=
# ASC_NAME_ADMINPAD=

# Optional overrides
# APP_TEAM_ID=92QV2QPDKA
# TEST_DEVICE=iPhone 17 Pro

# beta_external lanes: Beta App Review contact (required, private) and optional text
# BETA_REVIEW_FIRST_NAME=
# BETA_REVIEW_LAST_NAME=
# BETA_REVIEW_PHONE=+62...
# BETA_REVIEW_EMAIL=
# BETA_FEEDBACK_EMAIL=            # defaults to BETA_REVIEW_EMAIL
# BETA_GROUP=Beta                 # external group name in App Store Connect
# BETA_CHANGELOG=First external beta.
# BETA_DESCRIPTION=
