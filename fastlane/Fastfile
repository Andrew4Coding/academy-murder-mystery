require "base64"
require "tmpdir"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "Moonfall.xcodeproj")
TEAM_ID = ENV.fetch("APP_TEAM_ID", "92QV2QPDKA")

APPS = {
  ios: {
    scheme: "MoonfalliOS",
    bundle_id: "com.andrew4coding.Moonfall",
    xcconfig: File.join(ROOT, "iOS/MoonfalliOS.xcconfig"),
    metadata: File.join(ROOT, "fastlane/metadata/ios")
  },
  admin: {
    scheme: "MoonfallAdmin",
    bundle_id: "com.andrew4coding.Moonfall.admin",
    xcconfig: File.join(ROOT, "Admin/MoonfallAdmin.xcconfig"),
    metadata: File.join(ROOT, "fastlane/metadata/admin")
  },
  adminpad: {
    scheme: "MoonfallAdminiPad",
    bundle_id: "com.andrew4coding.Moonfall.adminpad",
    xcconfig: File.join(ROOT, "AdminiPad/MoonfallAdminiPad.xcconfig"),
    metadata: File.join(ROOT, "fastlane/metadata/adminpad")
  }
}.freeze

def app(name)
  APPS.fetch(name.to_s.to_sym) { UI.user_error!("app must be one of: #{APPS.keys.join(', ')}") }
end

def api_key
  content = ENV.fetch("ASC_KEY_CONTENT")
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: content,
    is_key_content_base64: !content.include?("BEGIN"),
    in_house: false
  )
end

def generate_project
  sh("cd #{ROOT} && xcodegen generate")
end

def next_build_number(key, target, platform)
  latest_testflight_build_number(api_key: key, app_identifier: target[:bundle_id], platform: platform) + 1
end

def asc_key_path
  content = ENV.fetch("ASC_KEY_CONTENT")
  pem = content.include?("BEGIN") ? content : Base64.decode64(content)
  path = File.join(Dir.tmpdir, "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
  File.write(path, pem, perm: 0o600)
  path
end

def provisioning_args
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{asc_key_path}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  ].join(" ")
end

def build_signed(platform, target, key, **extra)
  build_number = next_build_number(key, target, platform == :mac ? "osx" : "ios")
  args = {
    project: PROJECT,
    scheme: target[:scheme],
    configuration: "Release",
    destination: platform == :mac ? "generic/platform=macOS" : "generic/platform=iOS",
    export_method: "app-store",
    export_options: { signingStyle: "automatic", teamID: TEAM_ID },
    skip_profile_detection: true,
    xcargs: "#{provisioning_args} CURRENT_PROJECT_VERSION=#{build_number}",
    export_xcargs: provisioning_args,
    output_directory: File.join(ROOT, "build", target[:scheme]),
    clean: true
  }.merge(extra)
  platform == :mac ? build_mac_app(**args) : build_app(**args)
end

def bump_marketing_version(xcconfig, type)
  content = File.read(xcconfig)
  bumped = content.sub(/MARKETING_VERSION = (\d+)\.(\d+)\.(\d+)/) do
    major = Regexp.last_match(1).to_i
    minor = Regexp.last_match(2).to_i
    patch = Regexp.last_match(3).to_i
    case type.to_s
    when "major"
      major += 1
      minor = 0
      patch = 0
    when "minor"
      minor += 1
      patch = 0
    else
      patch += 1
    end
    "MARKETING_VERSION = #{major}.#{minor}.#{patch}"
  end
  UI.user_error!("MARKETING_VERSION not found in #{xcconfig}") if bumped == content
  File.write(xcconfig, bumped)
  UI.success(bumped[/MARKETING_VERSION = \S+/])
end

def upload_metadata(target, key, submit, extra = {})
  upload_to_app_store(
    api_key: key,
    metadata_path: target[:metadata],
    skip_screenshots: true,
    submit_for_review: submit == true,
    automatic_release: false,
    force: true,
    **extra
  )
end

before_all do
  setup_ci if ENV["CI"]
end

desc "Run SwiftLint and SwiftFormat over the whole repo"
lane :lint do
  sh("cd #{ROOT} && swiftlint --strict")
  sh("cd #{ROOT} && swiftformat --lint .")
end

desc "Regenerate Moonfall.xcodeproj from project.yml"
lane :generate do
  generate_project
end

desc "Register the bundle IDs and create the apps in App Store Connect (needs an Apple ID login, not the API key)"
lane :create_apps do |options|
  [
    [:ios, ENV.fetch("ASC_NAME_IOS", "Moonfall: Werewolf Night"), "ios"],
    [:admin, ENV.fetch("ASC_NAME_ADMIN", "Moonfall Admin"), "osx"],
    [:adminpad, ENV.fetch("ASC_NAME_ADMINPAD", "Moonfall OC"), "ios"]
  ].each do |key, name, platform|
    target = app(key)
    UI.user_error!("App name '#{name}' is #{name.length} characters; App Store Connect allows 30") if name.length > 30
    common = {
      username: ENV["FASTLANE_APPLE_ID"],
      app_identifier: target[:bundle_id],
      language: options[:language] || "en-US",
      sku: "moonfall-#{key}",
      platform: platform,
      team_id: ENV["FASTLANE_TEAM_ID"] || TEAM_ID,
      itc_team_id: ENV["FASTLANE_ITC_TEAM_ID"]
    }
    # The developer portal rejects punctuation in App ID names, App Store Connect does not.
    produce(**common, app_name: name.gsub(/[^0-9A-Za-z ]/, ""), skip_itc: true)
    produce(**common, app_name: name, skip_devcenter: true)
  end
end

desc "Bump one app's MARKETING_VERSION (app:ios|admin|adminpad type:patch|minor|major)"
lane :bump do |options|
  bump_marketing_version(app(options[:app] || APPS.keys.first)[:xcconfig], options[:type] || "patch")
end

platform :ios do
  ios_app = APPS[:ios]
  adminpad_app = APPS[:adminpad]

  desc "Run MoonfalliOS tests on iPhone 17 Pro"
  lane :test do
    generate_project
    run_tests(project: PROJECT, scheme: ios_app[:scheme], device: ENV["TEST_DEVICE"] || "iPhone 17 Pro", clean: true)
  end

  desc "Build MoonfalliOS and upload it to TestFlight"
  lane :beta do
    key = prepare_ios(ios_app)
    upload_to_testflight(api_key: key, app_identifier: ios_app[:bundle_id], skip_waiting_for_build_processing: true)
  end

  desc "Upload MoonfalliOS build and metadata to App Store Connect (submit_for_review:true to submit)"
  lane :release do |options|
    key = prepare_ios(ios_app)
    upload_metadata(ios_app, key, options[:submit_for_review], app_identifier: ios_app[:bundle_id])
  end

  desc "Build MoonfallAdminiPad and upload it to TestFlight"
  lane :adminpad_beta do
    key = prepare_ios(adminpad_app)
    upload_to_testflight(api_key: key, app_identifier: adminpad_app[:bundle_id], skip_waiting_for_build_processing: true)
  end

  private_lane :prepare_ios do |target|
    generate_project
    key = api_key
    build_signed(:ios, target, key)
    key
  end
end

platform :mac do
  mac_app = APPS[:admin]

  desc "Run MoonfallAdmin tests on macOS"
  lane :test do
    generate_project
    run_tests(project: PROJECT, scheme: mac_app[:scheme], destination: "platform=macOS", xcargs: "CODE_SIGNING_ALLOWED=NO", clean: true)
  end

  desc "Build MoonfallAdmin and upload it to TestFlight"
  lane :beta do
    key = prepare_mac(mac_app)
    upload_to_testflight(
      api_key: key,
      app_identifier: mac_app[:bundle_id],
      app_platform: "osx",
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload MoonfallAdmin build and metadata to App Store Connect (submit_for_review:true to submit)"
  lane :release do |options|
    key = prepare_mac(mac_app)
    upload_metadata(
      mac_app,
      key,
      options[:submit_for_review],
      app_identifier: mac_app[:bundle_id],
      platform: "osx",
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH]
    )
  end

  private_lane :prepare_mac do |target|
    generate_project
    key = api_key
    build_signed(:mac, target, key)
    key
  end
end
