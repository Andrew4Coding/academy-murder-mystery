#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == refs/heads/* ]] || continue
  [[ "$local_sha" == "$zero" ]] && continue

  branch="${remote_ref#refs/heads/}"

  if [[ "$branch" == "main" ]]; then
    # Creating main on a fresh remote is the one allowed direct push; after that, changes arrive through PRs.
    if [[ "$remote_sha" != "$zero" && "${ALLOW_MAIN_PUSH:-}" != "1" ]]; then
      echo "pre-push: direct pushes to main are not allowed. Push a branch and open a PR." >&2
      status=1
    fi
    continue
  fi

  "$root/scripts/check-branch-name.sh" "$branch" || status=1
done

exit $status
